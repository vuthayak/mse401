# Copy to backend/.env for local development. Never commit the real values.
# On Render these are set as service environment variables instead.

# Supabase — service role key, NOT the anon key. This key bypasses RLS and must
# never be exposed to the browser or baked into the Vite bundle.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
# Leave blank to run the deterministic rule-only pipeline.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Comma-separated browser origins allowed to call this API.
# Add your GitHub Pages origin for production, e.g. https://<user>.github.io
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEFAULT_STORE_ID=kw-flagship
MIN_CANDIDATE_POOL=3
REQUEST_TIMEOUT_SECONDS=12

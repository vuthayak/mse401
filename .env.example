# Copy to .env.local and fill in values from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the recommender API (see backend/README.md).
# Local:      http://127.0.0.1:8000
# Production: https://<your-service>.onrender.com
# Leaving this blank disables recommendations; the survey still records responses.
VITE_RECOMMENDER_API_URL=http://127.0.0.1:8000
